{
  "name": "yet-another-microsoft-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "generate:licenses": "node scripts/generate-license-manifest.mjs",
    "build:broker": "cargo build --manifest-path src-tauri/broker/Cargo.toml --target x86_64-pc-windows-msvc && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-broker.ps1 -TargetTriple x86_64-pc-windows-msvc -Profile debug",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Architecture all",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "clsx": "2.1.1",
    "lucide-react": "1.50.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "7.89.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "5.0.3",
    "vitest-axe": "0.1.0"
  }
}
